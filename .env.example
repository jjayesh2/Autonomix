# ==========================================
# Autonomix Environment Configuration Template
# ==========================================
# Copy this file to .env before starting the application.
# NEVER commit real private keys or secrets into version control.

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Supabase Database & Auth (Shared Production Project) ---
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
# Required for server-side admin role & RLS bypass on backend endpoints
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# --- Web3 & Base Sepolia Payment Configuration ---
# Base Sepolia Testnet (Chain ID 84532, CAIP-2: eip155:84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
CHAIN_ID=84532

# Buyer Agent Testnet Wallet Private Key (MUST BE TESTNET ONLY)
# Used by the Buyer Agent to sign x402 v2 payment authorizations for seller endpoints
# Leave empty to run in Sandbox/Mock mode (diagnostics will show Testnet Sandbox mode)
BUYER_WALLET_PRIVATE_KEY=

# Platform Treasury Address (receives platform fee if commission is enabled)
PLATFORM_TREASURY_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906
PLATFORM_FEE_PERCENT=10
PLATFORM_COMMISSION_ENABLED=true

# x402 v2 Facilitator Endpoint (Optional custom facilitator, defaults to direct settlement)
X402_FACILITATOR_URL=https://facilitator.x402.org

# --- AI Provider Configuration ---
# Supported providers: gemini | openai | anthropic | deterministic
# If no key is set, the system falls back to rule-based deterministic orchestration with clear labelling
AI_PROVIDER=deterministic
GEMINI_API_KEY= your_google_api_key_here 
OPENAI_API_KEY=

# --- Frontend Environment Variables (Vite) ---
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
VITE_API_URL=http://localhost:5000/api
VITE_CHAIN_ID=84532
VITE_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
